{
  "name": "zhihu-answer-review-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "知乎回答数据复盘助手 — 纯前端本地计算与相对诊断单页应用",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run tests/regression",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint:guard": "node scripts/lint-guard.mjs",
    "check:all": "npm run lint:guard && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
